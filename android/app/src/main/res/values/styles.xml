<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      LaunchTheme: shown while the process starts.
      windowBackground is the branded splash drawable.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!--
      NormalTheme: applied immediately after Flutter's first frame.
      windowBackground matches the game's dark background so there is no
      visible flash between the splash and the loading screen.
    -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/koko_night_deep</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
