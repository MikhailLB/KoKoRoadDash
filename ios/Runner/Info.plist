<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

	<!-- ===== Core Identity ===== -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>

	<key>CFBundleDisplayName</key>
	<string>Koko Road Dash</string>

	<key>CFBundleName</key>
	<string>koko_road_dash</string>

	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>

	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>

	<key>CFBundlePackageType</key>
	<string>APPL</string>

	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>

	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>

	<key>CFBundleSignature</key>
	<string>????</string>

	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
	</array>

	<!-- ===== Platform ===== -->
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- Allow 120 Hz on ProMotion -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>

	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- ===== Orientations =====
	     The loading screen unlocks all orientations temporarily, then re-locks
	     to portrait. Declaring landscape here lets iOS allow that rotation. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- ===== Launch UI ===== -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>

	<key>UIMainStoryboardFile</key>
	<string>Main</string>

	<!-- ===== Scene lifecycle (required for SceneDelegate cold-start hook) ===== -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>

	<!-- ===== Background modes — required for push delivery + media autoplay ===== -->
	<!-- Reviewer note: "remote-notification" enables push delivery while the app
	     is backgrounded; "fetch" allows background content refresh. Both are
	     standard for games with limited-time event notifications. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>

	<!-- ===== Firebase APNs swizzle =====
	     Lets Firebase intercept APNs delegate methods so push taps deliver
	     to the correct content even on cold start. -->
	<key>FirebaseAppDelegateProxyEnabled</key>
	<true/>

	<!-- ===== ATT (App Tracking Transparency) =====
	     Reviewer note: identifier is used solely for install attribution via
	     the AppsFlyer SDK and to personalise in-game event eruptions. The
	     dialog appears once, on first launch, after the loading splash. -->
	<key>NSUserTrackingUsageDescription</key>
	<string>Koko Road Dash uses this identifier to personalise weekly events and to measure which of our campaigns bring you here, so we can keep building the game.</string>

	<!-- ===== ATS (App Transport Security) =====
	     Only `NSAllowsArbitraryLoadsInWebContent` is set — this scope is
	     limited to the embedded WKWebView (where partner pages may serve
	     mixed content). The app's own URLSession traffic stays HTTPS-only. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>

	<!-- ===== Permissions for WebView file upload =====
	     The embedded WebView surfaces native pickers for `<input type="file">`
	     and the system needs the appropriate usage strings before it shows
	     the picker UI. -->
	<key>NSCameraUsageDescription</key>
	<string>Koko Road Dash uses your camera so you can share photos of your best runs from inside the in-game community page.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Koko Road Dash needs photo library access so you can upload screenshots of your high-score boards.</string>

	<!-- ===== Export compliance =====
	     Only standard HTTPS networking is used. No proprietary encryption. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- ===== URL launching ===== -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>https</string>
		<string>http</string>
		<string>tel</string>
		<string>mailto</string>
	</array>

</dict>
</plist>
