<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

	<!-- ===== Core Identity ===== -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>

	<key>CFBundleDisplayName</key>
	<string>Koko Road Dash</string>

	<!-- Short name shown under the icon on the home screen -->
	<key>CFBundleName</key>
	<string>Koko Road Dash</string>

	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>

	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>

	<key>CFBundlePackageType</key>
	<string>APPL</string>

	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>

	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>

	<key>CFBundleSignature</key>
	<string>????</string>

	<!-- ===== Localisations ===== -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
	</array>

	<!-- ===== Platform ===== -->
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- Allow 120 Hz on ProMotion displays -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>

	<!-- Prevent iPad Split View / Slide Over.
	     The game is a full-screen portrait experience. -->
	<key>UIRequiresFullScreen</key>
	<true/>

	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- ===== Orientations =====
	     The loading screen unlocks all orientations via
	     SystemChrome.setPreferredOrientations, then re-locks to portrait.
	     Declaring landscape here makes the OS allow that temporary rotation. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- iPad: portrait only (game is not optimised for iPad landscape) -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>

	<!-- ===== Launch UI ===== -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>

	<key>UIMainStoryboardFile</key>
	<string>Main</string>

	<!-- ===== Scene lifecycle (required by SceneDelegate) ===== -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>

	<!-- ===== App Store Export Compliance =====
	     The app uses only the standard HTTPS networking from Flutter's HTTP
	     stack. No custom or proprietary encryption algorithms are implemented.
	     Setting this to NO avoids the annual export compliance questionnaire. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- ===== URL scheme support =====
	     url_launcher opens URLs in the system browser (Safari). No custom
	     in-app scheme is registered. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>https</string>
	</array>

	<!-- ===== Status bar ===== -->
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>

	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>

</dict>
</plist>
